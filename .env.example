# Copie para .env (que fica fora do git) e preencha. Nunca coloque valores reais neste arquivo.
# No GitHub Actions, os mesmos nomes ficam em Settings > Secrets and variables > Actions.

# HMAC da anonimização. Guarde uma cópia segura: se mudar, o histórico se quebra.
CHAVE_ANONIMIZACAO=

# Supabase > Connect > Direct > Session pooler (URI), com a senha do banco.
DATABASE_URL=

# Fonte: um CSV baixado da planilha (carga manual) ...
ARQUIVO_PLANILHA=
# ... ou a API do Apps Script (carga diária pelo Actions).
RECADASTRAMENTO_API_URL=
RECADASTRAMENTO_API_TOKEN=
